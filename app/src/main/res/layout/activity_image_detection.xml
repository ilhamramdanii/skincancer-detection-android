<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:background="#F5F5F5">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_background"
            android:layout_marginBottom="32dp"
            android:elevation="8dp"/>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hasil Deteksi"
            android:textSize="20sp"
            android:textColor="#333333"
            android:paddingBottom="24dp" android:gravity="center"
            android:maxLines="5"
            android:scrollbars="vertical"
            android:lineSpacingExtra="4dp"
            android:textStyle="bold"/> <Button
        android:id="@+id/btnPickImage"
        android:layout_width="250dp" android:layout_height="wrap_content"
        android:text="Pilih Gambar dari Galeri"
        android:backgroundTint="#3498db"
        android:textColor="@android:color/white"
        android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:textSize="18sp" android:stateListAnimator="@null"
        android:translationZ="4dp"/>

    </LinearLayout>

</layout>